# ─────────────────────────────────────────────────────────────────────────────
# BD-Automator-Agent — Environment Configuration Template
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (Supabase Postgres via asyncpg) ───────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# ─── Redis (Upstash — use rediss:// for TLS) ────────────────────────────────
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# ─── Supabase Auth + Storage ────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...                    # Admin key — NEVER expose to frontend
SUPABASE_ANON_KEY=eyJ...                            # Safe for frontend use
SUPABASE_ADMIN_USER_ID=<uuid-of-admin-supabase-user>

# ─── Security ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<64-hex-chars>

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=<fernet-key>

# ─── CORS (comma-separated list of allowed origins) ─────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ─── Environment ────────────────────────────────────────────────────────────
# Options: development | staging | production
ENVIRONMENT=development

# ─── JWT ────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Google OAuth (for candidate Gmail linking) ─────────────────────────────
GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-<secret>

# ─── LLM APIs ───────────────────────────────────────────────────────────────
# Primary: Gemini
GEMINI_API_KEY=<your-gemini-api-key>

# Fallback providers (optional)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY_2=sk-ant-...
GROQ_API_KEY=gsk_...

# ─── Browser Automation (Module 4) ──────────────────────────────────────────
CAPTCHA_PROVIDER=capsolver                          # Options: capsolver | ocilar | 2captcha | anticaptcha
CAPSOLVER_API_KEY=
OCILAR_API_KEY=sk-...
TWO_CAPTCHA_API_KEY=your_2captcha_api_key_here
ANTI_CAPTCHA_API_KEY=your_anticaptcha_api_key_here

# Max captcha solve attempts on the Talent.com OTP/captcha gate
TALENT_CAPTCHA_ATTEMPTS=5

SCREENSHOT_LOCAL_DIR=./screenshots

PROXY_ENABLED=false
PROXY_RESIDENTIAL_URL=http://user:pass@proxy-host:port

# ─── Full Autonomy (Module 4 recommended settings) ──────────────────────────
# Job portals' robots.txt blocks bots by default ("User-agent: * Disallow: /"),
# which would gate the executor down to only permissive ATSes (e.g. Greenhouse).
# Setting this skips the robots.txt gate — the operator accepts responsibility
# for the one-shot, candidate-authorized form submissions this agent performs.
DISABLE_ROBOTS_CHECK=true

# AgentLoop budgets. Multi-step wizard ATSes (Dice, iCIMS, ZipRecruiter,
# Workday) need more than the built-in 60-step default.
AGENT_LOOP_MAX_STEPS=90
AGENT_LOOP_WALL_TIMEOUT_S=360

# ─── Production-hardening knobs (all optional; sane defaults shown) ──────────
# Field-memory staleness: recalled answers older than this many days are
# ignored (so old locations/companies don't resurface). 0 disables expiry.
FIELD_MEMORY_TTL_DAYS=180
# Gmail OTP polling budget (seconds). Some ATSes take 120s+ to send the code.
VERIFY_CODE_TIMEOUT_S=90
# Redis session TTL (days). Refreshed on every restore AND save, so an
# actively-used session never expires mid-batch. Clamped to >= 1 day.
SESSION_TTL_DAYS=7
# Built In → employer-ATS handoff: how long to wait for the new tab to open.
BUILTIN_NEWTAB_TIMEOUT_MS=25000

# Account-walled platform credentials — without these, applications on the
# platform fail fast with LOGIN_REQUIRED (no scraping bypass exists).
GLASSDOOR_EMAIL=
GLASSDOOR_PASSWORD=
# ZipRecruiter account must be created manually with a US phone number.
ZIPRECRUITER_EMAIL=
ZIPRECRUITER_PASSWORD=

# Opt-in WebGL identity spoofing. Off by default because real Chrome's genuine
# GPU strings are safer than spoofed ones (mismatched vendor/renderer pairs are
# a stronger bot signal than an honest fingerprint).
STEALTH_WEBGL_SPOOF=false

# Opt-in font-fingerprint countermeasure via measureText quantization. Off by
# default because DOM-API overrides risk the same coherence break that broke
# Greenhouse's react-select — only enable if a specific host demands it.
STEALTH_FONT_MASK=false

# LLM screenshot tiebreaker for post-submit success detection. When the text/URL
# heuristics are inconclusive, the AgentLoop asks the model to read a screenshot
# and decide SUBMITTED vs not. Set false to disable the extra LLM call.
AGENT_LOOP_VISUAL_SUCCESS=true

# ─── SPAM backoff (Phase 5.3) ───────────────────────────────────────────────
# After an ATS anti-bot SPAM rejection, that platform is put into an
# exponential cooldown (delay = base * 2**(strikes-1), capped) so we stop
# re-tripping its spam filter. Base backoff on the first rejection:
SPAM_BACKOFF_BASE_S=300
# Cap on the exponential SPAM backoff (default 4h):
SPAM_BACKOFF_MAX_S=14400

# Internal API base URL (used by Celery workers to call the FastAPI server)
M1_API_BASE_URL=http://localhost:8000/api

# ─── Observability ──────────────────────────────────────────────────────────
# Get from https://sentry.io (optional — leave blank to disable)
SENTRY_DSN=

# ─── App Settings ───────────────────────────────────────────────────────────
# Hour (0-23 UTC) to run daily job matching
DAILY_MATCH_HOUR=8

# Max applications submitted per candidate per day
MAX_DAILY_APPLICATIONS_PER_CANDIDATE=50

# Job matching lookback window in hours
JOB_MATCHING_LOOKBACK_HOURS=24
JOB_MATCHING_MONDAY_LOOKBACK_HOURS=72

# ─── Rate Limiting ──────────────────────────────────────────────────────────
# Max calls to /run-matching per user per minute
RATE_LIMIT_MATCHING_PER_MINUTE=5

# Max calls to /apply per user per minute
RATE_LIMIT_APPLY_PER_MINUTE=10
