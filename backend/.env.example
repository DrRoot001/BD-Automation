# =============================================================================
# BD-Automator Backend — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to git.
# =============================================================================

# ── Database (Supabase Postgres via asyncpg) ──────────────────────────────────
# Use port 6543 for the Supabase connection pooler (recommended for Celery workers)
# Use port 5432 for direct connections
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── Redis (Upstash — use rediss:// for TLS) ───────────────────────────────────
REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_HOST.upstash.io:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_ADMIN_USER_ID=

# ── Google OAuth (for Gmail scanning — Module 5) ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LLM APIs ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_2=
GROQ_API_KEY=

# ── Module 4: Browser Automation ──────────────────────────────────────────────
# Captcha provider: capsolver | 2captcha | anticaptcha | nopecha
CAPTCHA_PROVIDER=capsolver
CAPSOLVER_API_KEY=
TWO_CAPTCHA_API_KEY=
ANTI_CAPTCHA_API_KEY=
NOPECHA_API_KEY=
OCILAR_API_KEY=

SCREENSHOT_LOCAL_DIR=./screenshots
PROXY_ENABLED=false
PROXY_RESIDENTIAL_URL=http://user:pass@proxy-host:port

# Browser behaviour (set true for VPS / headless servers without XServer)
PLAYWRIGHT_HEADLESS=true
HEADLESS=true
STRICT_MEMORY_ISOLATION=true
VERIFY_DEMO_PAUSE_MS=1500
HUMAN_TYPE_MIN_MS=80
HUMAN_TYPE_MAX_MS=180
ASHBY_PRE_SUBMIT_DWELL_MS=4000
AGENT_LOOP_MAX_STEPS=80
AGENT_LOOP_WALL_TIMEOUT_S=360

# Platform overrides (set true to bypass checks during testing)
DISABLE_PLATFORM_BREAKER=false
DISABLE_ROBOTS_CHECK=false
ALLOW_REAL_LINKEDIN=1

# FlareSolverr (optional — for Cloudflare-protected sites)
FLARESOLVERR_URL=http://localhost:18191/v1

# ── Internal Service URL ───────────────────────────────────────────────────────
# Must match the port FastAPI runs on (8000). Used by Celery workers to call the API.
M1_API_BASE_URL=http://localhost:8000/api

# ─── Observability ──────────────────────────────────────────────────────────
# Get from https://sentry.io (optional — leave blank to disable)
SENTRY_DSN=

# ─── App Settings ───────────────────────────────────────────────────────────
# Developer isolation: local Celery queue prefix and single candidate limit
QUEUE_SUFFIX=
DEV_CANDIDATE_ID=
# ── App Settings ──────────────────────────────────────────────────────────────
# Register the 24h job-discovery scraper in the Celery beat schedule. Keep this
# OFF (0) on every dev machine except the ONE designated to own the schedule —
# multiple beats sharing this Redis/DB would each fire the Gemini scraper and
# waste tokens. Only takes effect where beat actually runs (RUN_BEAT=1 ./dev.sh).
ENABLE_AUTO_SCRAPE=0
DAILY_MATCH_HOUR=8
MAX_DAILY_APPLICATIONS_PER_CANDIDATE=50
JOB_MATCHING_LOOKBACK_HOURS=24
JOB_MATCHING_MONDAY_LOOKBACK_HOURS=72
# Gate threshold for application score. Score >= APPLY_SCORE_THRESHOLD will be tailored and queued for auto-apply.
APPLY_SCORE_THRESHOLD=75


# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MATCHING_PER_MINUTE=100
RATE_LIMIT_APPLY_PER_MINUTE=100
DISABLE_APPLICATION_LIMITS=false

# ── Optional: Portal credentials (for ATS login-gated sites) ─────────────────
# DICE_EMAIL=
# DICE_PASSWORD=
# WORKDAY_USERNAME=
# WORKDAY_PASSWORD=
# GLASSDOOR_EMAIL=
# GLASSDOOR_PASSWORD=
# ZIPRECRUITER_EMAIL=
# ZIPRECRUITER_PASSWORD=

# ── Optional: Error tracking ──────────────────────────────────────────────────
# SENTRY_DSN=
